# Lokal (docker-compose.dev.yml) — Ports im 5000er-Bereich (5000 selbst = macOS AirPlay):
#   PORT=5001
#   REDIS_URL=redis://localhost:5379/0
#   DATABASE_URL=postgres://postgres:dev@localhost:5432/mq
# Production (interne Coolify-URLs der Managed Services mq-redis, mq-postgres):
REDIS_URL=redis://default:CHANGE_ME@mq-redis:6379/0
DATABASE_URL=postgres://postgres:CHANGE_ME@mq-postgres:5432/mq

# Worker-Zuständigkeit (ADR-0003): Komma-getrennte Queue-Liste
WORKER_QUEUES=media,integrations

# App-Secret: schaltet POST /admin/consumers frei (min. 16 Zeichen)
ADMIN_KEY=CHANGE_ME_MIN_16_CHARS
