{
  "name": "weissteiner-automation-mq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:infra:down": "docker compose -f docker-compose.dev.yml down",
    "dev:api": "node --env-file=.env --import=tsx --watch src/api/index.ts",
    "dev:worker": "node --env-file=.env --import=tsx --watch src/worker/index.ts",
    "dev:board": "PORT=5002 node --env-file=.env --import=tsx --watch src/board/index.ts",
    "start:api": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "start:board": "node dist/board/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bull-board/api": "^8.0.0",
    "@bull-board/fastify": "^8.0.0",
    "@supabase/supabase-js": "^2.108.2",
    "bullmq": "^5.78.0",
    "fastify": "^5.8.5",
    "ioredis": "5.10.1",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/pg": "^8.20.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  }
}
